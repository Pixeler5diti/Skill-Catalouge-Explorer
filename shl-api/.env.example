# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# REQUIRED: Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# REQUIRED: Path to the SHL catalog JSON file
# Easiest: copy the catalog file into shl-api/ and rename it to catalog.json
#   then set:
CATALOG_PATH=catalog.json
#
# Or use the full original filename if you kept the repo structure as-is:
# CATALOG_PATH=../attached_assets/Pasted--entity-id-4302-name-Global-Skills-Development-Report-l_1782925068934.txt
#
# Or an absolute path:
# CATALOG_PATH=/Users/you/projects/shl/catalog.json

# ─── Optional overrides (defaults shown) ──────────────────────
# GROQ_MODEL=openai/gpt-oss-120b
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# FAISS_INDEX_DIR=data/faiss_index
# TOP_K_RETRIEVE=20
# TOP_K_RETURN=10
